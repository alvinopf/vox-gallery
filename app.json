{
  "expo": {
    "name": "Vox Gallery",
    "slug": "vox-gallery",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.alvinopf.voxgallery",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#0F2942",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "3e0b0522-0ff6-4281-860f-0356db416d01"
      }
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": false,
            "extraProguardRules": "-dontwarn expo.modules.**\n-dontwarn expo.modules.core.interfaces.services.KeepAwakeManager\n-dontwarn expo.modules.kotlin.types.**\n-dontwarn expo.modules.av.**\n-keep class expo.modules.av.** { *; }\n-keep class expo.modules.** { *; }"
          }
        }
      ],
      "expo-audio",
      [
        "expo-media-library",
        {
          "photosPermission": "Permitir que o Vox Gallery acesse suas fotos.",
          "savePhotosPermission": "Permitir que o Vox Gallery salve fotos."
        }
      ]
    ]
  }
}
